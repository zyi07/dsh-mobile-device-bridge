{
  "name": "dsh-mobile-device-bridge",
  "version": "0.2.7",
  "private": false,
  "type": "module",
  "description": "在设置页通过 WebUSB 或本机 adb/hdc 连接安卓/鸿蒙手机：执行命令、截图、传文件、安装/卸载应用（双通道）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib",
    "!lib/*.test.mjs",
    "tools/agc_login.py",
    "extension",
    "assets",
    "README.md",
    "LICENSE",
    "docs/DETAIL.md",
    "tools/agc_sign.py"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@yume-chan/adb": "^2.1.0",
    "@yume-chan/adb-credential-web": "^2.1.0",
    "@yume-chan/adb-daemon-webusb": "^2.1.0",
    "@yume-chan/stream-extra": "^2.1.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node src-client/hdc/codec.test.mjs && node src-client/hdc/transport.test.mjs && node src-client/hdc/session.test.mjs && node src-client/hdc/multi-device.test.mjs && node lib/cli-channel.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "android",
    "adb",
    "harmonyos",
    "hdc",
    "webusb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyi07/dsh-mobile-device-bridge.git"
  },
  "homepage": "https://github.com/zyi07/dsh-mobile-device-bridge#readme",
  "bugs": {
    "url": "https://github.com/zyi07/dsh-mobile-device-bridge/issues"
  }
}